# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/artifacts/realtime-benchmarks/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
data/*.json
data/*.tmp

# Local brand source assets. Runtime-ready public assets remain tracked, while
# working files and editable Illustrator sources stay outside the repository.
/data/brand-assets/
/public/brands/**/*.ai

# Local agent configuration and file-backed operational closeouts.
/.claude/
/data/queue-summaries/

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example
.env.vercel
.env.development.local
.dev.vars
.dev.vars.*
!.dev.vars.example
.wrangler/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
